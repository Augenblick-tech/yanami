","count":1,"total_cont":12},{"name":"青年漫画","count":1,"total_cont":4978},{"name":"妖怪","count":1,"total_cont":593},{"name":"Nemuki+","count":1,"total_cont":1},{"name":"百鬼夜行抄","count":1,"total_cont":23},{"name":"日本","count":1,"total_cont":39575},{"name":"魑魅魍魉","count":1,"total_cont":11},{"name":"女作者","count":1,"total_cont":111},{"name":"热血","count":1,"total_cont":12431},{"name":"長篇","count":1,"total_cont":165},{"name":"ネムキ","count":1,"total_cont":23},{"name":"朝日新聞出版","count":1,"total_cont":60}],"infobox":[{"key":"中文名","value":"百鬼夜行抄"},{"key":"别名","value":[{"v":"ひゃっきやこうしょう"}]},{"key":"作画","value":"今市子"},{"key":"出版社","value":"朝日新聞出版"},{"key":"发售日","value":"1995-09"},{"key":"册数","value":"既刊26巻"},{"key":"开始","value":"1995年（ネムキ vol.23）"}],"rating":{"rank":2019,"total":37,"count":{"1":0,"2":0,"3":0,"4":0,"5":1,"6":3,"7":9,"8":17,"9":4,"10":3},"score":7.8},"collection":{"on_hold":7,"dropped":2,"wish":84,"collect":36,"doing":33},"id":31256,"eps":0,"total_episodes":0,"meta_tags":["日本","漫画","原创","系列"],"volumes":0,"series":true,"locked":false,"nsfw":false,"type":1},{"date":"2026-04-07","platform":"TV","images":{"small":"https://lain.bgm.tv/r/200/pic/cover/l/00/fe/627137_j1SHJ.jpg","grid":"https://lain.bgm.tv/r/100/pic/cover/l/00/fe/627137_j1SHJ.jpg","large":"https://lain.bgm.tv/pic/cover/l/00/fe/627137_j1SHJ.jpg","medium":"https://lain.bgm.tv/r/800/pic/cover/l/00/fe/627137_j1SHJ.jpg","common":"https://lain.bgm.tv/r/400/pic/cover/l/00/fe/627137_j1SHJ.jpg"},"image":"https://lain.bgm.tv/pic/cover/l/00/fe/627137_j1SHJ.jpg","summary":"律从已故祖父那里继承了不可思议灵力，以及一位名为「青岚」的恶魔守护者。某一次，他梦见了童年的往事。在梦中，为了躲避妖魔的觊觎，年幼的律被迫打扮成女孩子的模样，却仍差点遭到一名少女幽灵的袭击。就在不久后的某一天，律亲眼目睹那名幽灵混在母亲茶道教室的学生群中，潜入了家中。正当律试图查明对方的真面目时，却在名为「捉迷藏」的游戏中，被灵体夺走了左眼！？\r\n\r\n奇怪的事情似乎总是围绕着他们两人发生，而揭开所有这些神秘事件真相的重任就落在了他们身上。\r\n每个故事都是独立的，但其中穿插着一些会逐渐熟悉并喜爱的角色，他们各自以不同的方式应对着「非此世之事」。\r\n\r\n\r\n\r\n[简介原文]\r\n飯嶋律は、祖父・飯嶋蝸牛から\r\n妖魔を見ることができる不思議な力を\r\n受け継いでいた。\r\nそのために幼い頃から妖魔に狙われてきた律は\r\n妖魔の目をあざむくために\r\n髪を伸ばし、女の子の着物を着せられて\r\n育てられていた時期もあった。\r\n\r\n蝸牛亡きあと、祖母、母親、父親と暮らす\r\n律のかたわらには\r\n彼を守護する三匹の妖魔がいた。\r\n\r\n律の父親の体を借りた強力な妖魔・青嵐、\r\n忠実ではあるが頼りにならない尾白と尾黒。\r\n\r\nそしてさまざまな妖魔との出会いは\r\n律とその家族を今日も\r\n奇妙な事件に巻き込んでいく……","name":"百鬼夜行抄","name_cn":"百鬼夜行抄","tags":[{"name":"2026年4月","count":24,"total_cont":12458},{"name":"漫画改","count":15,"total_cont":805563},{"name":"奇幻","count":12,"total_cont":429251},{"name":"2026","count":12,"total_cont":22692},{"name":"泡面番","count":11,"total_cont":149525},{"name":"漫改","count":10,"total_cont":343878},{"name":"ImagicaInfos","count":9,"total_cont":41},{"name":"TV","count":7,"total_cont":1325362},{"name":"妖怪","count":6,"total_cont":7872},{"name":"日本","count":5,"total_cont":253798},{"name":"ImageworksStudio","count":5,"total_cont":85},{"name":"动态漫","count":4,"total_cont":90},{"name":"今市子","count":2,"total_cont":2},{"name":"26春","count":2,"total_cont":80}],"infobox":[{"key":"中文名","value":"百鬼夜行抄"},{"key":"话数","value":"12"},{"key":"放送开始","value":"2026年4月7日"},{"key":"放送星期","value":"星期二"},{"key":"官方网站","value":"https://publications.asahi.com/feature/hyakki-anime/"},{"key":"导演","value":"深瀬沙哉"},{"key":"音乐","value":"kidlit"},{"key":"Copyright","value":"©今市子/朝日新聞出版"},{"key":"原作","value":"今市子「百鬼夜行抄」(「目隠し鬼」より)"},{"key":"分镜","value":"田中明日香"},{"key":"动画","value":"柴山千里、宇佐見明花、田中明日香"},{"key":"摄影","value":"柴山千里、宇佐見明花、田中明日香"},{"key":"制作进行","value":"深瀬沙、C2哉"},{"key":"2Dworks","value":"株式会社ステインラボ"},{"key":"音响监督","value":"三浦妙子"},{"key":"音效","value":"宅間麻姫"},{"key":"录音调整","value":"篠原茉莉"},{"key":"录音助理","value":"杉野美結"},{"key":"音响工作室","value":"デルファイサウンド"},{"key":"音响制作","value":"株式会社アルディ"},{"key":"在线编辑工作室","value":"Imagica EMS"},{"key":"动画制作","value":"Imagica Infos(イマジカインフォス)、Imageworks Studio"},{"key":"演出","value":"田中明日香"},{"key":"製作","value":"株式会社朝日新聞出版"},{"key":"制作协力","value":"UWAN Pictures"},{"key":"企画","value":"大日本印刷株式会社"}],"rating":{"rank":0,"total":32,"count":{"1":5,"2":2,"3":11,"4":3,"5":4,"6":0,"7":3,"8":0,"9":2,"10":2},"score":4.2},"collection":{"on_hold":3,"dropped":28,"wish":83,"collect":4,"doing":125},"id":627137,"eps":12,"total_episodes":12,"meta_tags":["TV","日本","奇幻","漫画改"],"volumes":0,"series":false,"locked":false,"nsfw":false,"type":2},{"date":"2007-03-21","platform":"","images":{"small":"https://lain.bgm.tv/r/200/pic/cover/l/96/e0/7729_jp.jpg","grid":"https://lain.bgm.tv/r/100/pic/cover/l/96/e0/7729_jp.jpg","large":"https://lain.bgm.tv/pic/cover/l/96/e0/7729_jp.jpg","medium":"https://lain.bgm.tv/r/800/pic/cover/l/96/e0/7729_jp.jpg","common":"https://lain.bgm.tv/r/400/pic/cover/l/96/e0/7729_jp.jpg"},"image":"https://lain.bgm.tv/pic/cover/l/96/e0/7729_jp.jpg","summary":"经典中国风，著名的配乐家森英治为这次的真人版《百鬼夜行抄》担当原声配乐的制作；而片尾曲则选用了Fonogenico的ねがいごと；专辑的封面选择了今市子的原画，充分体现除了对作者的尊重。\r\n\r\n尽管真人版的《百鬼夜行抄》因为制作成本较低的原因，而导致整体素质不尽人意（其实还算看得过去，想当时我也是追着跑来着……），甚至被日本网友嘲笑为“鬼怪特摄片”，但这部深夜档日剧还是以超出预期的收视率顺利完结了。\r\n\r\n当然除了演员们卖力演出之外，最受到一致好评的，便是由森英治所打造的剧中配乐。尤其以主题曲《百鬼夜行抄》获得了极高的人气，以致于电视剧一开播，冲着那片头那夹杂着几句台词的，短短几秒音乐片段而来的观众比比皆是。熟练的应用二胡、竹笛等中国乐器，合奏出东方味浓郁的悠扬旋律，凄美动人，幻想无疆，与漫画原作今市子笔下那个满是喜怒嗔骂的鬼怪世界极为合衬，堪称是06冬季日剧中配乐水准最高的杰作。","name":"百鬼夜行抄 o.s.t","name_cn":"","tags":[{"name":"OST","count":16,"total_cont":73128},{"name":"森英治","count":10,"total_cont":30},{"name":"百鬼夜行抄","count":9,"total_cont":15},{"name":"2007","count":3,"total_cont":2163},{"name":"未观看原作","count":1,"total_cont":605},{"name":"电视剧","count":1,"total_cont":270},{"name":"日本","count":1,"total_cont":9483},{"name":"日剧原声带","count":1,"total_cont":5},{"name":"日剧","count":1,"total_cont":141},{"name":"TVdrama","count":1,"total_cont":35},{"name":"Fonogenico","count":1,"total_cont":9}],"infobox":[{"key":"版本特性","value":"CD"},{"key":"发售日期","value":"2007-03-21"},{"key":"价格","value":"￥ 2,500"},{"key":"播放时长","value":"43 m"},{"key":"录音","value":"バップ"},{"key":"碟片数量","value":"1"},{"key":"发行方","value":"バップ"}],"rating":{"rank":1232,"total":42,"count":{"1":0,"2":0,"3":1,"4":1,"5":1,"6":3,"7":3,"8":16,"9":8,"10":9},"score":8.1},"collection":{"on_hold":0,"dropped":1,"wish":9,"collect":51,"doing":1},"id":7729,"eps":0,"total_episodes":0,"meta_tags":[],"volumes":0,"series":false,"locked":false,"nsfw":false,"