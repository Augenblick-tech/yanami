# yanami 配置文件模板
# 复制本文件为 config.toml，按需修改后启动程序

# 工作/数据目录路径
data_dir = "."

[server]
# 绑定的主机地址
host = "0.0.0.0"
# 监听的端口
port = 3000

[database]
# 数据库文件路径或连接字符串
path = "data.db"

[auth]
# 用于签发 JWT Token 的密钥
jwt_secret = "default_secret_key_change_me"
# JWT Token 的过期时间 (单位：秒)
jwt_expire_seconds = 3600
# 用于加密敏感信息的主密钥
crypto_secret = "default_secret_key_change_me"

[external]
# TMDB API 读取权限的 Token (必填，用于获取番剧元数据)
tmdb_token = "your-tmdb-token"
